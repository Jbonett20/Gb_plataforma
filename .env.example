# =============================================================================
# Configuración de la plataforma — copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" al repositorio.
# =============================================================================

# --- Identidad de la aplicación --------------------------------------------
APP_NAME="González & Ballesteros"
APP_ENV=local
# En producción SIEMPRE en false: nunca mostrar errores técnicos al visitante.
APP_DEBUG=true
APP_URL=http://localhost/gbplataforma/public
APP_TIMEZONE=America/Bogota
# Clave secreta para firmar enlaces temporales de contenido. Genera una nueva:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# --- Base de datos ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gb_plataforma
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Base de datos del sitio anterior ---------------------------------------
# Sólo se usan una vez, para traer los suscriptores y las citas que ya existen:
#   php database/seeds/legacy-import.php
# Déjalas vacías cuando termines la migración.
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# --- Correo saliente --------------------------------------------------------
#
# DEJADO SIN ACTIVAR A PROPÓSITO.
#
# Con MAIL_HOST vacío no sale ningún correo: los mensajes (recordatorios,
# enlaces para restablecer contraseña, comprobantes de compra) se guardan
# completos en storage/logs/mail y el asistente de instalación lo avisa.
#
# PARA ACTIVARLO: rellena las cuatro primeras líneas con la cuenta de correo del
# despacho y reinicia. No hay que tocar nada más. Si usas Gmail, MAIL_PASSWORD
# no es la contraseña normal sino una "contraseña de aplicación" que se genera
# en la cuenta de Google.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=gerencia@gonzalezballesteros.com
MAIL_FROM_NAME="González & Ballesteros"

# --- Pasarela de pago -------------------------------------------------------
# Proveedor activo: wompi | payu | stripe | paypal | manual
PAYMENT_GATEWAY=manual

# Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_SANDBOX=true

# PayU (Latinoamérica)
PAYU_MERCHANT_ID=
PAYU_API_KEY=
PAYU_ACCOUNT_ID=
PAYU_SANDBOX=true

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Moneda de la plataforma (ISO 4217)
PAYMENT_CURRENCY=COP
PAYMENT_CURRENCY_SYMBOL=$

# --- Sesiones y seguridad ---------------------------------------------------
SESSION_NAME=gb_session
# Minutos de inactividad permitidos antes de cerrar la sesión.
SESSION_LIFETIME_STUDENT=120
SESSION_LIFETIME_ADMIN=20
# Sesiones simultáneas permitidas por cuenta de estudiante.
MAX_CONCURRENT_SESSIONS=2
# Intentos fallidos de inicio de sesión antes de bloquear temporalmente.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Cuando esté en false, el login acepta identificadores válidos sin exigir un
# correo con formato completo. Cuando pase a true, solo se aceptará correo.
EMAIL_LOGIN_REQUIRED=false
LEGACY_LOGIN_ENABLED=true
PAYMENTS_ENABLED=false

# --- Carga de archivos ------------------------------------------------------
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_DOCUMENT_MB=64
UPLOAD_MAX_VIDEO_MB=512

# --- Contenido protegido ----------------------------------------------------
# Vigencia en segundos de los enlaces firmados de video y material de pago.
PROTECTED_LINK_TTL=600

# --- Comportamiento del sitio -----------------------------------------------
# Días que se conserva contenido eliminado antes de poder borrarlo definitivamente.
TRASH_RETENTION_DAYS=30
# Registro de suscriptores: libre | opcional | obligatorio
TEMPLATE_DOWNLOAD_POLICY=libre
# Caché del HTML de las páginas públicas (segundos). Se vacía al publicar cambios.
VIEW_CACHE=true
VIEW_CACHE_TTL=600
